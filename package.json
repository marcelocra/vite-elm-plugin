{
  "name": "vite-elm-plugin",
  "version": "0.1.0",
  "description": "Compile your Elm files as part of the Vite development workflow.",
  "type": "module",
  "exports": "./vite-elm-plugin.js",
  "license": "BSD-3-Clause",
  "files": [
    "main.js"
  ],
  "scripts": {
    "release": "esbuild ./vite-elm-plugin.ts --bundle --minify --sourcemap --format=esm --platform=node --outfile=vite-elm-plugin.js"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^20.14.5",
    "esbuild": "0.23.0",
    "eslint": "^9.8.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "npm-run-all2": "^6.2.0",
    "prettier": "^3.3.3",
    "vite": "^5.3.5"
  },
  "prettier": {
    "importOrder": [
      "^node:",
      "^npm:",
      "^jsr:",
      "<THIRD_PARTY_MODULES>",
      "^@/(.*)$",
      "^[./]",
      "^[../]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ]
  },
  "author": {
    "name": "Marcelo Almeida",
    "email": "2532492+marcelocra@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcelocra/vite-elm-plugin"
  }
}
